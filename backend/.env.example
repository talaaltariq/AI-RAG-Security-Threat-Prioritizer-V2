# ThreatIQ Backend Environment Variables
PORT=8000
HOST=0.0.0.0
DATABASE_URL=sqlite:///./threatiq.db
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=models/gemini-embedding-001
LLM_MODEL=gemini-3.6-flash
ENVIRONMENT=development

# Comma-separated list of frontend origins allowed by CORS ("*" = any origin).
# Local dev default: http://localhost:3000
# Production example: https://threatiq.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Optional: relocate the ChromaDB vector store (e.g. onto a mounted persistent
# disk on Render/Railway). Unset = backend/data/chroma_db
# CHROMA_PERSIST_DIR=/var/lib/threatiq/chroma_db