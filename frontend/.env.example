# ThreatIQ Frontend Environment Variables
# Local development: the FastAPI backend on localhost
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production (Vercel): set this to your deployed backend URL instead, e.g.
# NEXT_PUBLIC_API_URL=https://threatiq-backend.onrender.com
# Note: NEXT_PUBLIC_* values are inlined at build time — after changing this
# variable on Vercel you must trigger a redeploy.
